{
  "name": "video-editor",
  "version": "1.0.0",
  "description": "Programmatic video editing system using Remotion, FFmpeg, and Whisper AI",
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx remotion studio",
    "render": "npx remotion render MyVideo out/video.mp4",
    "stitch": "npx ts-node scripts/stitch.ts",
    "transcribe": "npx ts-node scripts/transcribe.ts",
    "desktop": "concurrently \"PORT=3005 npm run dev\" \"wait-on http://localhost:3005 && electron .\"",
    "build-desktop": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.learntobot.videoeditor",
    "productName": "Neil Clipper",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"]
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*",
      ".next/**/*",
      "public/**/*"
    ]
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "@remotion/tailwind": "^4.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.379.0",
    "next": "^14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "wait-on": "^9.0.10"
  }
}
